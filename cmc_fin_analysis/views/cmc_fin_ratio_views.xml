<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cmc_fin_ratio_list" model="ir.ui.view">
        <field name="name">cmc.fin.ratio.list</field>
        <field name="model">cmc.fin.ratio</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="area"/>
                <field name="unit"/>
                <field name="threshold_op"/>
                <field name="threshold" invisible="not threshold_op"/>
                <field name="full_only"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_cmc_fin_ratio_form" model="ir.ui.view">
        <field name="name">cmc.fin.ratio.form</field>
        <field name="model">cmc.fin.ratio</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="area"/>
                            <field name="unit"/>
                            <field name="expression"/>
                        </group>
                        <group>
                            <field name="threshold_op"/>
                            <field name="threshold" invisible="not threshold_op"/>
                            <field name="full_only"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cmc_fin_ratio_search" model="ir.ui.view">
        <field name="name">cmc.fin.ratio.search</field>
        <field name="model">cmc.fin.ratio</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_area" string="Area" context="{'group_by': 'area'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cmc_fin_ratio" model="ir.actions.act_window">
        <field name="name">Ratios</field>
        <field name="res_model">cmc.fin.ratio</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_area': 1}</field>
    </record>
</odoo>
