<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cmc_cvr_list" model="ir.ui.view">
        <field name="name">cmc.cvr.analysis.list</field>
        <field name="model">cmc.cvr.analysis</field>
        <field name="arch" type="xml">
            <list string="CVR / Break-even">
                <field name="name"/>
                <field name="mode"/>
                <field name="bep_qty"/>
                <field name="bep_revenue"/>
                <field name="operating_leverage"/>
                <field name="has_breakeven" widget="badge"
                       decoration-success="has_breakeven"
                       decoration-danger="not has_breakeven"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cmc_cvr_curve_graph" model="ir.ui.view">
        <field name="name">cmc.cvr.curve.graph</field>
        <field name="model">cmc.cvr.curve</field>
        <field name="arch" type="xml">
            <graph string="Break-even Chart" type="line" sample="1">
                <field name="volume" type="row"/>
                <field name="revenue" type="measure"/>
                <field name="total_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_cmc_cvr_form" model="ir.ui.view">
        <field name="name">cmc.cvr.analysis.form</field>
        <field name="model">cmc.cvr.analysis</field>
        <field name="arch" type="xml">
            <form string="CVR / Break-even Analysis">
                <header>
                    <button name="action_recompute" type="object" string="Recompute"/>
                    <widget name="web_ribbon" title="No Break-even"
                            bg_color="text-bg-danger" invisible="has_breakeven"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not range_warning">
                        <field name="range_warning" readonly="1" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Inputs">
                            <field name="mode"/>
                            <field name="is_multiproduct"/>
                            <field name="center_id" invisible="mode == 'simulazione'"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="price_unit" invisible="is_multiproduct"/>
                            <field name="variable_unit" invisible="is_multiproduct"/>
                            <field name="fixed_cost"/>
                            <field name="target_basis" invisible="is_multiproduct"/>
                            <field name="target_profit" invisible="is_multiproduct or target_basis == 'margin_pct'"/>
                            <field name="tax_rate" invisible="is_multiproduct or target_basis != 'after_tax'"/>
                            <field name="target_margin_pct" invisible="is_multiproduct or target_basis != 'margin_pct'"/>
                            <field name="volume" invisible="is_multiproduct"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="has_breakeven" invisible="1"/>
                        </group>
                        <group string="Results">
                            <field name="mc_unit" invisible="is_multiproduct"/>
                            <field name="mc_ratio"/>
                            <field name="bep_qty"/>
                            <field name="bep_revenue"/>
                            <field name="target_profit_pretax" invisible="is_multiproduct"/>
                            <field name="target_qty" invisible="is_multiproduct"/>
                            <field name="target_revenue" invisible="is_multiproduct"/>
                            <field name="margin_of_safety"/>
                            <field name="mos_ratio"/>
                            <field name="operating_leverage"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products (mix)" name="lines" invisible="not is_multiproduct">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="price_unit"/>
                                    <field name="variable_unit"/>
                                    <field name="mc_unit"/>
                                    <field name="mix_share"/>
                                    <field name="bep_qty"/>
                                    <field name="bep_revenue"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="What-if" name="whatif" invisible="is_multiproduct">
                            <group string="Sensitivity">
                                <field name="sens_pct"/>
                            </group>
                            <field name="sensitivity_html" readonly="1" nolabel="1"/>
                            <group string="Iso-profit">
                                <field name="iso_lever"/>
                                <field name="iso_pct"/>
                                <field name="iso_compensate"/>
                            </group>
                            <field name="iso_profit_html" readonly="1" nolabel="1"/>
                            <group string="Cost structure comparison">
                                <field name="alt_variable_unit"/>
                                <field name="alt_fixed_cost"/>
                            </group>
                            <field name="structure_html" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Break-even Curve" name="curve" invisible="is_multiproduct">
                            <field name="curve_ids" readonly="1">
                                <list>
                                    <field name="volume"/>
                                    <field name="revenue"/>
                                    <field name="total_cost"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cmc_cvr_analysis" model="ir.actions.act_window">
        <field name="name">CVR / Break-even</field>
        <field name="res_model">cmc.cvr.analysis</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_cmc_sec_direct"
              name="Direct Costing &amp; Decisions"
              parent="cmc_base.menu_cmc_operations"
              sequence="40"/>
    <menuitem id="menu_cmc_cvr" name="CVR / Break-even"
              parent="menu_cmc_sec_direct"
              action="action_cmc_cvr_analysis" sequence="20"/>
</odoo>
