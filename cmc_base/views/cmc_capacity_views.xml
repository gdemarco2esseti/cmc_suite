<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cmc_capacity_list" model="ir.ui.view">
        <field name="name">cmc.capacity.analysis.list</field>
        <field name="model">cmc.capacity.analysis</field>
        <field name="arch" type="xml">
            <list string="Capacity Analysis">
                <field name="center_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="capacity_practical"/>
                <field name="capacity_actual"/>
                <field name="utilization_rate" optional="show"/>
                <field name="fixed_cost" sum="Fixed"/>
                <field name="imputed_fixed_cost" sum="Imputed"/>
                <field name="unused_capacity_cost" sum="Unused"
                       decoration-warning="unused_capacity_cost > 0"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cmc_capacity_form" model="ir.ui.view">
        <field name="name">cmc.capacity.analysis.form</field>
        <field name="model">cmc.capacity.analysis</field>
        <field name="arch" type="xml">
            <form string="Capacity Analysis">
                <header>
                    <button name="action_recompute" type="object" string="Recompute"/>
                    <button name="action_estimate_practical" type="object" string="Estimate Practical"
                            invisible="not downtime_rate"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="center_id"/>
                            <field name="driver_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group string="Capacity (driver units)">
                        <group>
                            <field name="capacity_theoretical"/>
                            <field name="downtime_rate"/>
                            <field name="capacity_practical"/>
                            <field name="capacity_normal"/>
                            <field name="capacity_budget"/>
                            <field name="capacity_actual"/>
                            <field name="utilization_rate"/>
                        </group>
                        <group string="Cost of Capacity">
                            <field name="total_cost"/>
                            <field name="fixed_cost"/>
                            <field name="fixed_cost_coefficient"/>
                            <field name="imputed_fixed_cost"/>
                            <field name="unused_capacity_cost"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Cost per Driver Unit by Capacity Level" name="coefficients">
                        <group>
                            <field name="coefficient_theoretical"/>
                            <field name="coefficient_practical"/>
                            <field name="coefficient_normal"/>
                        </group>
                        <group>
                            <field name="coefficient_budget"/>
                            <field name="coefficient_actual"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cmc_capacity_pivot" model="ir.ui.view">
        <field name="name">cmc.capacity.analysis.pivot</field>
        <field name="model">cmc.capacity.analysis</field>
        <field name="arch" type="xml">
            <pivot string="Capacity Analysis">
                <field name="center_id" type="row"/>
                <field name="fixed_cost" type="measure"/>
                <field name="imputed_fixed_cost" type="measure"/>
                <field name="unused_capacity_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_cmc_capacity" model="ir.actions.act_window">
        <field name="name">Capacity Analysis</field>
        <field name="res_model">cmc.capacity.analysis</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Analyze cost center capacity</p>
            <p>Impute fixed costs on practical capacity and isolate the cost of
               unused capacity per center and period.</p>
        </field>
    </record>

    <menuitem id="menu_cmc_capacity"
              name="Capacity Analysis"
              parent="menu_cmc_sec_analysis"
              action="action_cmc_capacity"
              sequence="20"/>
</odoo>
