<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_cmc_cockpit_dashboard" model="ir.actions.client">
        <field name="name">Cockpit</field>
        <field name="tag">cmc_controller_dashboard</field>
    </record>

    <record id="action_cmc_setup_guide" model="ir.actions.client">
        <field name="name">Setup Guide</field>
        <field name="tag">cmc_setup_guide</field>
    </record>

    <menuitem id="menu_cmc_cockpit"
              name="Cockpit"
              parent="menu_cmc_root"
              action="action_cmc_cockpit_dashboard"
              sequence="1"
              groups="cmc_base.group_cmc_user"/>

    <menuitem id="menu_cmc_setup_guide"
              name="Setup Guide"
              parent="menu_cmc_config"
              action="action_cmc_setup_guide"
              sequence="5"/>
</odoo>
