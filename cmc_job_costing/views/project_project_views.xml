<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_project_view_form_cmc_job" model="ir.ui.view">
        <field name="name">project.project.form.cmc.job</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_cmc_job_sheets" type="object" class="oe_stat_button" icon="fa-calculator"
                        string="Job Cost Sheets" groups="cmc_base.group_cmc_user"/>
            </div>
            <xpath expr="//sheet" position="inside">
                <group name="cmc_job" string="Job costing" groups="cmc_base.group_cmc_manager">
                    <field name="cmc_job_closed"/>
                    <field name="cmc_job_close_date" required="cmc_job_closed"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
