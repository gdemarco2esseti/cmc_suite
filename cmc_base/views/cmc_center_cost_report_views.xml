<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cmc_center_cost_report_pivot" model="ir.ui.view">
        <field name="name">cmc.center.cost.report.pivot</field>
        <field name="model">cmc.center.cost.report</field>
        <field name="arch" type="xml">
            <pivot string="Cost by Center (rolled up)" sample="1">
                <field name="rollup_center_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_cmc_center_cost_report_graph" model="ir.ui.view">
        <field name="name">cmc.center.cost.report.graph</field>
        <field name="model">cmc.center.cost.report</field>
        <field name="arch" type="xml">
            <graph string="Cost by Center (rolled up)" type="bar" sample="1">
                <field name="rollup_center_id"/>
                <field name="cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_cmc_center_cost_report_list" model="ir.ui.view">
        <field name="name">cmc.center.cost.report.list</field>
        <field name="model">cmc.center.cost.report</field>
        <field name="arch" type="xml">
            <list string="Cost by Center" create="false" edit="false">
                <field name="date"/>
                <field name="rollup_center_id"/>
                <field name="center_id"/>
                <field name="depth" optional="hide"/>
                <field name="element_id"/>
                <field name="controllable" optional="show"/>
                <field name="cost" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <button name="action_open_lines" type="object" icon="fa-search-plus"
                        title="Journal items" groups="cmc_base.group_cmc_user"/>
            </list>
        </field>
    </record>

    <record id="view_cmc_center_cost_report_search" model="ir.ui.view">
        <field name="name">cmc.center.cost.report.search</field>
        <field name="model">cmc.center.cost.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="rollup_center_id"/>
                <field name="center_id"/>
                <field name="element_id"/>
                <filter name="controllable" string="Controllable" domain="[('controllable', '=', True)]"/>
                <filter name="not_controllable" string="Not Controllable" domain="[('controllable', '=', False)]"/>
                <separator/>
                <filter name="booked_here" string="Booked Here" domain="[('depth', '=', 0)]"/>
                <group name="groupby">
                    <filter name="g_rollup" string="Rolled up to" context="{'group_by': 'rollup_center_id'}"/>
                    <filter name="g_center" string="Booked on" context="{'group_by': 'center_id'}"/>
                    <filter name="g_element" string="Cost Element" context="{'group_by': 'element_id'}"/>
                    <filter name="g_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cmc_center_cost_report" model="ir.actions.act_window">
        <field name="name">Cost by Center</field>
        <field name="res_model">cmc.center.cost.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_g_rollup': 1}</field>
    </record>

    <menuitem id="menu_cmc_center_cost_report"
              name="Cost by Center"
              parent="menu_cmc_sec_responsibility"
              action="action_cmc_center_cost_report"
              sequence="20"/>
</odoo>
