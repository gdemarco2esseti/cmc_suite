<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cmc_rule_company_rule" model="ir.rule">
            <field name="name">CMC classification rule: multi-company</field>
            <field name="model_id" ref="model_cmc_classification_rule"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'parent_of', company_ids)]</field>
        </record>
        <record id="cmc_manual_classification_company_rule" model="ir.rule">
            <field name="name">CMC manual classification: multi-company</field>
            <field name="model_id" ref="model_cmc_manual_classification"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
