<odoo>
    <!-- record rules live OUTSIDE noupdate so a domain fix reaches installed databases -->
    <data>
        <record id="cmc_scenario_comparison_company_rule" model="ir.rule">
            <field name="name">cmc.scenario.comparison: multi-company</field>
            <field name="model_id" ref="model_cmc_scenario_comparison"/>
