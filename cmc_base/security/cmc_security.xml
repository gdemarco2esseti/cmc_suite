            <field name="model_id" ref="model_cmc_responsibility_center"/>
            <field name="groups" eval="[(4, ref('cmc_base.group_cmc_responsible'))]"/>
            <field name="domain_force">[('owner_id', '=', user.id)]</field>
        </record>

        <record id="cmc_responsibility_center_user_rule" model="ir.rule">
            <field name="name">CMC responsibility center: all (controlling user)</field>
            <field name="model_id" ref="model_cmc_responsibility_center"/>
            <field name="groups" eval="[(4, ref('cmc_base.group_cmc_user'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="cmc_responsibility_capital_responsible_rule" model="ir.rule">
            <field name="name">CMC responsibility capital: own responsibility</field>
            <field name="model_id" ref="model_cmc_responsibility_capital"/>
            <field name="groups" eval="[(4, ref('cmc_base.group_cmc_responsible'))]"/>
            <field name="domain_force">[('responsibility_id.owner_id', '=', user.id)]</field>
