<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- record rules live OUTSIDE noupdate: a domain fix must reach installed databases -->
    <data>
        <record id="cmc_kpi_company_rule" model="ir.rule">
            <field name="name">CMC KPI: multi-company</field>
            <field name="model_id" ref="model_cmc_kpi"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>
        <record id="cmc_kpi_value_company_rule" model="ir.rule">
            <field name="name">CMC KPI value: multi-company</field>
            <field name="model_id" ref="model_cmc_kpi_value"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>
        <record id="cmc_kpi_run_company_rule" model="ir.rule">
            <field name="name">CMC KPI run: multi-company</field>
            <field name="model_id" ref="model_cmc_kpi_run"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>
        <record id="cmc_kpi_scorecard_company_rule" model="ir.rule">
            <field name="name">CMC KPI scorecard: multi-company</field>
            <field name="model_id" ref="model_cmc_kpi_scorecard"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>
        <record id="cmc_kpi_scorecard_perspective_company_rule" model="ir.rule">
            <field name="name">CMC KPI scorecard perspective: multi-company</field>
            <field name="model_id" ref="model_cmc_kpi_scorecard_perspective"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>
        <record id="cmc_kpi_scorecard_line_company_rule" model="ir.rule">
            <field name="name">CMC KPI scorecard line: multi-company</field>
            <field name="model_id" ref="model_cmc_kpi_scorecard_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>
        <record id="cmc_kpi_target_company_rule" model="ir.rule">
            <field name="name">CMC KPI target: multi-company</field>
            <field name="model_id" ref="model_cmc_kpi_target"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>
        <record id="cmc_kpi_scorecard_result_company_rule" model="ir.rule">
            <field name="name">CMC KPI scorecard result: multi-company</field>
            <field name="model_id" ref="model_cmc_kpi_scorecard_result"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>
        <record id="cmc_kpi_responsible_rule" model="ir.rule">
            <field name="name">CMC KPI: own responsibility</field>
            <field name="model_id" ref="model_cmc_kpi"/>
            <field name="groups" eval="[(4, ref('cmc_base.group_cmc_responsible'))]"/>
            <field name="domain_force">[('responsibility_id.owner_id', '=', user.id)]</field>
        </record>
        <record id="cmc_kpi_user_rule" model="ir.rule">
            <field name="name">CMC KPI: all (controlling user)</field>
            <field name="model_id" ref="model_cmc_kpi"/>
            <field name="groups" eval="[(4, ref('cmc_base.group_cmc_user'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="cmc_kpi_value_responsible_rule" model="ir.rule">
            <field name="name">CMC KPI value: own responsibility</field>
            <field name="model_id" ref="model_cmc_kpi_value"/>
            <field name="groups" eval="[(4, ref('cmc_base.group_cmc_responsible'))]"/>
            <field name="domain_force">[('responsibility_id.owner_id', '=', user.id)]</field>
        </record>
        <record id="cmc_kpi_value_user_rule" model="ir.rule">
            <field name="name">CMC KPI value: all (controlling user)</field>
            <field name="model_id" ref="model_cmc_kpi_value"/>
            <field name="groups" eval="[(4, ref('cmc_base.group_cmc_user'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
