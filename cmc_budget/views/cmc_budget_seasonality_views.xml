<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cmc_budget_seasonality_list" model="ir.ui.view">
        <field name="name">cmc.budget.seasonality.list</field>
        <field name="model">cmc.budget.seasonality</field>
        <field name="arch" type="xml">
            <list string="Seasonality Profiles">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_cmc_budget_seasonality_form" model="ir.ui.view">
        <field name="name">cmc.budget.seasonality.form</field>
        <field name="model">cmc.budget.seasonality</field>
        <field name="arch" type="xml">
            <form string="Seasonality Profile">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Summer peak"/></h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="month"/>
                            <field name="weight"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cmc_budget_seasonality" model="ir.actions.act_window">
        <field name="name">Seasonality Profiles</field>
        <field name="res_model">cmc.budget.seasonality</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a seasonality profile</p>
            <p>Monthly weights used to split an annual figure into months.</p>
        </field>
    </record>
</odoo>
