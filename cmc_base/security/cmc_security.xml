            <field name="model_id" ref="model_cmc_closing_run"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'parent_of', company_ids)]</field>
        </record>

        <record id="cmc_closing_line_company_rule" model="ir.rule">
            <field name="name">CMC closing line: multi-company</field>
            <field name="model_id" ref="model_cmc_closing_line"/>
            <field name="global" eval="True"/>
