<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cmc_budget_cash_run_list" model="ir.ui.view">
        <field name="name">cmc.budget.cash.run.list</field>
        <field name="model">cmc.budget.cash.run</field>
        <field name="arch" type="xml">
            <list string="Cash Forecasts">
                <field name="name"/>
                <field name="version_id"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_cmc_budget_cash_run_form" model="ir.ui.view">
        <field name="name">cmc.budget.cash.run.form</field>
        <field name="model">cmc.budget.cash.run</field>
        <field name="arch" type="xml">
            <form string="Cash Forecast">
                <header>
                    <button name="action_compute" type="object" string="Compute"
                            class="oe_highlight" invisible="state == 'done'"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft" invisible="state != 'done'"
                            confirm="Resetting deletes the computed results. Continue?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="version_id" readonly="state == 'done'"/>
                            <field name="opening_balance" readonly="state == 'done'"/>
                            <field name="company_id" readonly="state == 'done'" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="customer_payment_term_id" readonly="state == 'done'"/>
                            <field name="supplier_payment_term_id" readonly="state == 'done'"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list create="false" edit="false">
                            <field name="date"/>
                            <field name="inflow" sum="Inflow"/>
                            <field name="outflow" sum="Outflow"/>
                            <field name="net" sum="Net"/>
                            <field name="cumulative" decoration-danger="cumulative &lt; 0"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cmc_budget_cash_run" model="ir.actions.act_window">
        <field name="name">Cash Forecasts</field>
        <field name="res_model">cmc.budget.cash.run</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a cash forecast</p>
            <p>Turn a budget into monthly cash inflows and outflows using payment terms.</p>
        </field>
    </record>
</odoo>
