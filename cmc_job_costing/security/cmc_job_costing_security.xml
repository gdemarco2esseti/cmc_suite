<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- record rules live OUTSIDE noupdate: a domain fix must reach installed databases -->
    <data>
        <record id="cmc_job_rate_company_rule" model="ir.rule">
            <field name="name">CMC job rate: multi-company</field>
            <field name="model_id" ref="model_cmc_job_rate"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>

        <record id="cmc_job_cost_run_company_rule" model="ir.rule">
            <field name="name">CMC job cost run: multi-company</field>
            <field name="model_id" ref="model_cmc_job_cost_run"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>

        <record id="cmc_job_sheet_company_rule" model="ir.rule">
            <field name="name">CMC job sheet: multi-company</field>
            <field name="model_id" ref="model_cmc_job_sheet"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>

        <record id="cmc_job_sheet_labour_company_rule" model="ir.rule">
            <field name="name">CMC job sheet labour: multi-company</field>
            <field name="model_id" ref="model_cmc_job_sheet_labour"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>
    </data>
</odoo>
