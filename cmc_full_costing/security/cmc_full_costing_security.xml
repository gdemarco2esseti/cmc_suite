<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cmc_costing_run_company_rule" model="ir.rule">
            <field name="name">CMC costing run: multi-company</field>
            <field name="model_id" ref="model_cmc_costing_run"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'parent_of', company_ids)]</field>
        </record>

