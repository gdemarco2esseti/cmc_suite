<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cmc_abc_activity_company_rule" model="ir.rule">
            <field name="name">CMC ABC activity: multi-company</field>
            <field name="model_id" ref="model_cmc_abc_activity"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'parent_of', company_ids)]</field>
        </record>
        <record id="cmc_abc_run_company_rule" model="ir.rule">
            <field name="name">CMC ABC run: multi-company</field>
            <field name="model_id" ref="model_cmc_abc_run"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>
        <record id="cmc_abc_line_company_rule" model="ir.rule">
            <field name="name">CMC ABC line: multi-company</field>
            <field name="model_id" ref="model_cmc_abc_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>
        <record id="cmc_abc_result_company_rule" model="ir.rule">
            <field name="name">CMC ABC result: multi-company</field>
            <field name="model_id" ref="model_cmc_abc_result"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>
    </data>
</odoo>
