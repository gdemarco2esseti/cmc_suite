<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_form_cmc" model="ir.ui.view">
        <field name="name">mrp.production.form.cmc</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <field name="bom_id" position="after">
                <!-- account.analytic.account is readable only by
                     analytic.group_analytic_accounting, and a shop-floor
                     mrp.group_mrp_user has no such right: guard the field
                     like core guards every analytic field it exposes on an
                     operational document. group_cmc_user implies
                     analytic.group_analytic_accounting. -->
                <field name="cmc_center_id" groups="cmc_base.group_cmc_user"/>
            </field>
        </field>
    </record>
</odoo>
