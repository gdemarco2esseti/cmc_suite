msgid "CMC Consumption Move"
msgstr "Movimento di consumo CMC"

#. module: cmc_mrp
#: model:ir.model.fields,field_description:cmc_mrp.field_mrp_production__cmc_center_id
msgid "CMC Cost Center"
msgstr "Centro di costo CMC"

#. module: cmc_mrp
#: model:ir.model.fields,field_description:cmc_mrp.field_stock_move__cmc_mrp_analytic_line_ids
msgid "CMC Material Cost Lines"
msgstr "Righe di costo materiali CMC"

#. module: cmc_mrp
#. odoo-python
#: code:addons/cmc_mrp/models/mrp_production.py:0
msgid ""
"CMC cost center %(center)s belongs to company %(center_company)s and cannot "
"absorb the cost of a manufacturing order of %(company)s."
msgstr ""
"Il centro di costo CMC %(center)s appartiene all'azienda %(center_company)s "
"e non può assorbire il costo di un ordine di produzione di %(company)s."

#. module: cmc_mrp
#. odoo-python
#: code:addons/cmc_mrp/models/mrp_production.py:0
msgid ""
"CMC cost center %(center)s must belong to the root analytic plan to absorb "
"manufacturing cost."
msgstr ""
"Il centro di costo CMC %(center)s deve appartenere al piano analitico radice"
" per assorbire il costo di produzione."

#. module: cmc_mrp
#: model:ir.model.fields,help:cmc_mrp.field_mrp_production__cmc_center_id
msgid ""
"Cost center that absorbs the direct material (MP) cost of this manufacturing"
" order in management control. Must belong to the root analytic plan and to "
"the company of the order."
msgstr ""
"Centro di costo che assorbe nel controllo di gestione il costo delle materie"
" prime (MP) di questo ordine di produzione. Deve appartenere al piano "
"analitico radice."

