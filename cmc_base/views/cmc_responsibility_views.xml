<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cmc_responsibility_center_list" model="ir.ui.view">
        <field name="name">cmc.responsibility.center.list</field>
        <field name="model">cmc.responsibility.center</field>
        <field name="arch" type="xml">
            <list string="Responsibility Centers">
                <field name="name"/>
                <field name="responsibility_type"/>
                <field name="owner_id" widget="many2one_avatar_user"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_cmc_responsibility_center_form" model="ir.ui.view">
        <field name="name">cmc.responsibility.center.form</field>
        <field name="model">cmc.responsibility.center</field>
        <field name="arch" type="xml">
            <form string="Responsibility Center">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Production Department"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="responsibility_type"/>
                            <field name="owner_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cost Centers" name="centers">
                            <field name="center_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Invested Capital" name="capital"
                              invisible="responsibility_type not in ('investment', 'profit') and not capital_ids">
                            <field name="capital_ids">
                                <list string="Invested Capital" editable="bottom">
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cmc_responsibility_center_search" model="ir.ui.view">
        <field name="name">cmc.responsibility.center.search</field>
        <field name="model">cmc.responsibility.center</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="owner_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group name="groupby">
                    <filter name="g_type" string="Type" context="{'group_by': 'responsibility_type'}"/>
                    <filter name="g_owner" string="Responsible" context="{'group_by': 'owner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cmc_responsibility_center" model="ir.actions.act_window">
        <field name="name">Responsibility Centers</field>
        <field name="res_model">cmc.responsibility.center</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a responsibility center</p>
            <p>Group cost centers under the person accountable for them.</p>
        </field>
    </record>

    <record id="view_cmc_responsibility_summary_form" model="ir.ui.view">
        <field name="name">cmc.responsibility.summary.form</field>
        <field name="model">cmc.responsibility.summary</field>
        <field name="arch" type="xml">
            <form string="Controllable Cost and ROI">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <field name="line_ids" readonly="1" invisible="not line_ids">
                    <list string="Responsibility Summary" create="false" edit="false">
                        <field name="responsibility_id"/>
                        <field name="responsibility_type" optional="hide"/>
                        <field name="owner_id" widget="many2one_avatar_user" optional="show"/>
                        <field name="controllable_cost" sum="Controllable"/>
                        <field name="non_controllable_cost" sum="Non-controllable"/>
                        <field name="revenue" sum="Revenue"/>
                        <field name="result" sum="Result"
                               decoration-danger="result &lt; 0"/>
                        <field name="invested_capital" optional="show"/>
                        <field name="roi" widget="percentage" optional="show"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_compute" type="object" string="Compute" class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Close" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cmc_responsibility_summary" model="ir.actions.act_window">
        <field name="name">Controllable Cost and ROI</field>
        <field name="res_model">cmc.responsibility.summary</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_cmc_responsibility_center"
              name="Responsibility Centers"
              parent="menu_cmc_sec_responsibility"
              action="action_cmc_responsibility_center"
              sequence="10"/>
    <menuitem id="menu_cmc_responsibility_summary"
              name="Controllable Cost and ROI"
              parent="menu_cmc_sec_responsibility"
              action="action_cmc_responsibility_summary"
              sequence="30"/>
</odoo>
