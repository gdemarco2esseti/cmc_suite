<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- record rules live OUTSIDE noupdate: a domain fix must be able to
         reach databases that already have the module installed -->
    <data>
        <record id="cmc_tdabc_characteristic_company_rule" model="ir.rule">
            <field name="name">CMC TDABC characteristic: multi-company</field>
            <field name="model_id" ref="model_cmc_tdabc_characteristic"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'parent_of', company_ids)]</field>
        </record>
