<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cmc_rule_list" model="ir.ui.view">
        <field name="name">cmc.classification.rule.list</field>
        <field name="model">cmc.classification.rule</field>
        <field name="arch" type="xml">
            <list string="Classification Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="general_account_id"/>
                <field name="account_code_prefix"/>
                <field name="cmc_behavior"/>
                <field name="cmc_directness"/>
                <field name="cmc_cost_element_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_cmc_rule_form" model="ir.ui.view">
        <field name="name">cmc.classification.rule.form</field>
        <field name="model">cmc.classification.rule</field>
        <field name="arch" type="xml">
            <form string="Classification Rule">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Match (blank = any)">
                            <field name="sequence"/>
                            <field name="general_account_id"/>
                            <field name="account_code_prefix"/>
                            <field name="product_category_id"/>
                            <field name="partner_id"/>
                            <field name="center_id"/>
                        </group>
                        <group string="Assign (fill-only)">
                            <field name="cmc_behavior"/>
                            <field name="cmc_directness"/>
                            <field name="cmc_cost_element_id"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cmc_classification_rule" model="ir.actions.act_window">
        <field name="name">Classification Rules</field>
        <field name="res_model">cmc.classification.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_cmc_cfg_integration"
              name="Integrazione contabile"
              parent="cmc_base.menu_cmc_config"
              sequence="20"/>
    <menuitem id="menu_cmc_classification_rule" name="Classification Rules"
              parent="menu_cmc_cfg_integration"
              action="action_cmc_classification_rule" sequence="10"/>
</odoo>
