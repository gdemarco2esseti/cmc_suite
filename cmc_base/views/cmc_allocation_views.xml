<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cmc_allocation_list" model="ir.ui.view">
        <field name="name">cmc.allocation.list</field>
        <field name="model">cmc.allocation</field>
        <field name="arch" type="xml">
            <list string="Cost Allocations">
                <field name="name"/>
                <field name="source_account_id"/>
                <field name="driver_id"/>
                <field name="amount"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cmc_allocation_form" model="ir.ui.view">
        <field name="name">cmc.allocation.form</field>
        <field name="model">cmc.allocation</field>
        <field name="arch" type="xml">
            <form string="Cost Allocation">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Maintenance March"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="source_account_id"/>
                            <field name="driver_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list string="Allocation Lines" editable="bottom">
                            <field name="target_account_id"/>
                            <field name="quantity"/>
                            <field name="allocated_amount" sum="Total"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cmc_allocation" model="ir.actions.act_window">
        <field name="name">Cost Allocations</field>
        <field name="res_model">cmc.allocation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a cost allocation</p>
            <p>Spread a common cost across cost centers by a driver-based allocation base.</p>
        </field>
    </record>
</odoo>
