<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cmc_allocation_list" model="ir.ui.view">
        <field name="name">cmc.allocation.list</field>
        <field name="model">cmc.allocation</field>
        <field name="arch" type="xml">
            <list string="Cost Allocations">
                <field name="name"/>
                <field name="source_account_id"/>
                <field name="driver_id"/>
                <field name="amount"/>
                <field name="date"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cmc_allocation_form" model="ir.ui.view">
        <field name="name">cmc.allocation.form</field>
        <field name="model">cmc.allocation</field>
        <field name="arch" type="xml">
            <form string="Cost Allocation">
                <header>
                    <button name="action_compute" type="object" string="Compute"
                            class="oe_highlight" invisible="state == 'done'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state != 'done'"
                            confirm="Resetting deletes the posted analytic lines. Continue?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Maintenance March"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="source_account_id" readonly="state == 'done'"/>
                            <field name="driver_id" readonly="state == 'done'"/>
                            <field name="element_id" readonly="state == 'done'"/>
                            <field name="behavior" readonly="state == 'done'"/>
                        </group>
                        <group>
                            <field name="amount" readonly="state == 'done'"/>
                            <field name="date" readonly="state == 'done'"/>
                            <field name="company_id" readonly="state == 'done'" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allocation Lines" name="lines">
                            <field name="line_ids" readonly="state == 'done'">
                                <list string="Allocation Lines" editable="bottom">
                                    <field name="target_account_id"/>
                                    <field name="quantity"/>
                                    <field name="allocated_amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Posted Lines" name="posted" invisible="state != 'done'">
                            <field name="posted_line_ids" readonly="1">
                                <list string="Posted Lines" create="false" edit="false">
                                    <field name="date"/>
                                    <field name="account_id"/>
                                    <field name="name"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cmc_allocation" model="ir.actions.act_window">
        <field name="name">Cost Allocations</field>
        <field name="res_model">cmc.allocation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a cost allocation</p>
            <p>Spread a common cost across cost centers by a driver-based allocation base.</p>
        </field>
    </record>
</odoo>
