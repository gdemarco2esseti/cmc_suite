<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Baseline: the plan version form gets the project control pages ===== -->
    <record id="view_cmc_plan_version_form_evm" model="ir.ui.view">
        <field name="name">cmc.plan.version.form.evm</field>
        <field name="model">cmc.plan.version</field>
        <field name="inherit_id" ref="cmc_base.view_cmc_plan_version_form"/>
        <field name="arch" type="xml">
            <button name="action_approve" position="before">
                <button name="action_cmc_evm_plan" type="object" string="Plan Baseline"
                        invisible="version_type != 'baseline' or state != 'draft'"/>
            </button>
            <field name="parent_id" position="after">
                <field name="project_id" readonly="state == 'done'" required="version_type == 'baseline'"
                       invisible="version_type != 'baseline'"/>
                <field name="cmc_rate_driver_id" readonly="state == 'done'" invisible="version_type != 'baseline'"/>
                <field name="management_reserve_percent" readonly="state == 'done'" invisible="version_type != 'baseline'"/>
            </field>
            <field name="currency_id" position="after">
                <field name="currency_id" invisible="1"/>
            </field>
            <xpath expr="//notebook" position="inside">
                <page name="evm_estimate" string="Estimate" invisible="version_type != 'baseline'">
                    <field name="estimate_line_ids" readonly="state == 'done'">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="task_id" domain="[('project_id', '=', parent.project_id)]"/>
                            <field name="center_id"/>
                            <field name="hours_optimistic"/>
                            <field name="hours_most_likely"/>
                            <field name="hours_pessimistic"/>
                            <field name="hours_expected"/>
                            <field name="hourly_rate"/>
                            <field name="material_cost"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="cost_expected" sum="Expected"/>
                            <field name="cost_sigma" optional="hide"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group>
                        <group string="Accuracy (95 %)">
                            <field name="estimate_expected"/>
                            <field name="estimate_sigma"/>
                            <field name="estimate_low"/>
                            <field name="estimate_high"/>
                        </group>
                    </group>
                </page>
                <page name="evm_risk" string="Risks" invisible="version_type != 'baseline'">
                    <field name="risk_ids" readonly="state == 'done'">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="task_id" domain="[('project_id', '=', parent.project_id)]"/>
                            <field name="probability"/>
                            <field name="impact"/>
                            <field name="emv" sum="EMV"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
                <page name="evm_reserves" string="Reserves" invisible="version_type != 'baseline'">
                    <group>
                        <group>
                            <field name="bac"/>
                            <field name="contingency_reserve"/>
                            <field name="cost_baseline"/>
                            <field name="management_reserve"/>
                            <field name="project_budget"/>
                        </group>
                    </group>
                </page>
                <page name="evm_pv" string="Planned Value" invisible="version_type != 'baseline'">
                    <field name="baseline_line_ids" readonly="1">
                        <list create="false" edit="false" delete="false">
                            <field name="task_id"/>
                            <field name="date"/>
                            <field name="planned_value" sum="PV"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
                <page name="evm_changes" string="Change Requests" invisible="version_type != 'baseline'">
                    <field name="change_request_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="task_id"/>
                            <field name="date"/>
                            <field name="cost_impact"/>
                            <field name="state" widget="badge"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_cmc_evm_baseline" model="ir.actions.act_window">
        <field name="name">Baselines</field>
        <field name="res_model">cmc.plan.version</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('version_type', '=', 'baseline')]</field>
        <field name="context">{'default_version_type': 'baseline'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a project baseline</p>
            <p>Estimate the work packages with three points, rate the hours from the rate card, then approve to freeze the time-phased cost baseline.</p>
        </field>
    </record>

    <!-- ===== Change requests ===== -->
    <record id="view_cmc_evm_change_request_list" model="ir.ui.view">
        <field name="name">cmc.evm.change.request.list</field>
        <field name="model">cmc.evm.change.request</field>
        <field name="arch" type="xml">
            <list string="Change Requests">
                <field name="name"/>
                <field name="baseline_id"/>
                <field name="task_id"/>
                <field name="date"/>
                <field name="cost_impact" sum="Impact"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cmc_evm_change_request_form" model="ir.ui.view">
        <field name="name">cmc.evm.change.request.form</field>
        <field name="model">cmc.evm.change.request</field>
        <field name="arch" type="xml">
            <form string="Change Request">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight"
                            invisible="state != 'draft'" groups="cmc_base.group_cmc_manager"
                            confirm="Approving creates a new draft baseline including this change. Continue?"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="state != 'draft'"/></h1></div>
                    <group>
                        <group>
                            <field name="baseline_id" readonly="state != 'draft'"/>
                            <field name="task_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="cost_impact" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="new_baseline_id" invisible="not new_baseline_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cmc_evm_change_request" model="ir.actions.act_window">
        <field name="name">Change Requests</field>
        <field name="res_model">cmc.evm.change.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===== S-curve ===== -->
    <record id="view_cmc_evm_curve_graph" model="ir.ui.view">
        <field name="name">cmc.evm.curve.graph</field>
        <field name="model">cmc.evm.curve</field>
        <field name="arch" type="xml">
            <graph string="S-Curve" type="line">
                <field name="date" interval="month"/>
                <field name="pv_cumulative" type="measure"/>
                <field name="ev_cumulative" type="measure"/>
                <field name="ac_cumulative" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_cmc_evm_curve_list" model="ir.ui.view">
        <field name="name">cmc.evm.curve.list</field>
        <field name="model">cmc.evm.curve</field>
        <field name="arch" type="xml">
            <list string="Monthly Curve" create="false" edit="false" delete="false">
                <field name="run_id"/>
                <field name="date"/>
                <field name="pv_cumulative"/>
                <field name="ev_cumulative"/>
                <field name="ac_cumulative"/>
                <field name="cv"/>
                <field name="out_of_control"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cmc_evm_curve_search" model="ir.ui.view">
        <field name="name">cmc.evm.curve.search</field>
        <field name="model">cmc.evm.curve</field>
        <field name="arch" type="xml">
            <search string="Monthly Curve">
                <field name="run_id"/>
            </search>
        </field>
    </record>

    <record id="action_cmc_evm_curve_run" model="ir.actions.act_window">
        <field name="name">S-Curve</field>
        <field name="res_model">cmc.evm.curve</field>
        <field name="view_mode">graph,list</field>
    </record>

    <!-- ===== EVM status report ===== -->
    <record id="view_cmc_evm_run_list" model="ir.ui.view">
        <field name="name">cmc.evm.run.list</field>
        <field name="model">cmc.evm.run</field>
        <field name="arch" type="xml">
            <list string="EVM Status Reports">
                <field name="name"/>
                <field name="project_id"/>
                <field name="status_date"/>
                <field name="cpi" optional="show"/>
                <field name="spi" optional="show"/>
                <field name="eac" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cmc_evm_run_form" model="ir.ui.view">
        <field name="name">cmc.evm.run.form</field>
        <field name="model">cmc.evm.run</field>
        <field name="arch" type="xml">
            <form string="EVM Status Report">
                <header>
                    <button name="action_compute" type="object" string="Compute" class="oe_highlight" invisible="state == 'done'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state != 'done'"
                            confirm="Resetting deletes the computed results. Continue?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_cmc_evm_curve_run)d" type="action" class="oe_stat_button" icon="fa-line-chart"
                                string="S-Curve" invisible="state != 'done'" context="{'search_default_run_id': id}"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="state == 'done'"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" readonly="state == 'done'"/>
                            <field name="baseline_id" readonly="state == 'done'" domain="[('version_type', '=', 'baseline'), ('project_id', '=', project_id)]"/>
                            <field name="job_run_id" readonly="state == 'done'"/>
                        </group>
                        <group>
                            <field name="status_date" readonly="state == 'done'"/>
                            <field name="control_limit" readonly="state == 'done'"/>
                            <field name="company_id" readonly="state == 'done'" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Indices" invisible="state != 'done'">
                        <group>
                            <field name="bac"/>
                            <field name="pv"/>
                            <field name="ev"/>
                            <field name="ac"/>
                            <field name="cv"/>
                            <field name="sv"/>
                            <field name="cpi"/>
                            <field name="spi"/>
                            <field name="tcpi"/>
                        </group>
                        <group string="Forecast">
                            <field name="eac"/>
                            <field name="eac_atypical"/>
                            <field name="eac_composite"/>
                            <field name="etc"/>
                            <field name="vac"/>
                            <field name="out_of_control_count"/>
                            <field name="rule_of_seven"/>
                        </group>
                    </group>
                    <notebook invisible="state != 'done'">
                        <page name="tasks" string="Work Packages">
                            <field name="task_line_ids" readonly="1">
                                <list create="false" edit="false">
                                    <field name="task_id"/>
                                    <field name="bac" sum="BAC"/>
                                    <field name="percent_complete"/>
                                    <field name="pv" sum="PV"/>
                                    <field name="ev" sum="EV"/>
                                    <field name="sv" sum="SV"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page name="curve" string="Monthly Curve">
                            <field name="curve_ids" readonly="1">
                                <list create="false" edit="false"
                                      decoration-danger="out_of_control" decoration-muted="is_forecast">
                                    <field name="date"/>
                                    <field name="pv"/>
                                    <field name="ev"/>
                                    <field name="ac"/>
                                    <field name="cv"/>
                                    <field name="pv_cumulative"/>
                                    <field name="ev_cumulative"/>
                                    <field name="ac_cumulative"/>
                                    <field name="out_of_control" widget="boolean"/>
                                    <field name="is_forecast" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cmc_evm_run" model="ir.actions.act_window">
        <field name="name">EVM Status Reports</field>
        <field name="res_model">cmc.evm.run</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an EVM status report</p>
            <p>Measure a job against its approved baseline: earned value from the task progress, actual cost from the job cost run.</p>
        </field>
    </record>

    <!-- ===== Task: physical progress ===== -->
    <record id="view_task_form2_cmc_progress" model="ir.ui.view">
        <field name="name">project.task.form.cmc.progress</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='user_ids'])[1]" position="after">
                <field name="cmc_progress" groups="cmc_base.group_cmc_user"/>
            </xpath>
        </field>
    </record>
</odoo>
