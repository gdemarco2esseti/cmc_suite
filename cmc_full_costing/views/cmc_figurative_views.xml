<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cmc_figurative_list" model="ir.ui.view">
        <field name="name">cmc.figurative.cost.list</field>
        <field name="model">cmc.figurative.cost</field>
        <field name="arch" type="xml">
            <list string="Figurative Costs">
                <field name="name"/>
                <field name="cost_element_id"/>
                <field name="method"/>
                <field name="cmc_directness"/>
                <field name="amount" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cmc_figurative_form" model="ir.ui.view">
        <field name="name">cmc.figurative.cost.form</field>
        <field name="model">cmc.figurative.cost</field>
        <field name="arch" type="xml">
            <form string="Figurative Cost">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Interest on capital"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="cost_element_id"/>
                            <field name="method"/>
                            <field name="capital" invisible="method != 'interest'"/>
                            <field name="rate" invisible="method != 'interest'"/>
                            <field name="amount" readonly="method == 'interest'"/>
                        </group>
                        <group>
                            <field name="cost_object_ref"/>
                            <field name="cmc_directness"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cmc_figurative" model="ir.actions.act_window">
        <field name="name">Figurative Costs</field>
        <field name="res_model">cmc.figurative.cost</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a figurative cost</p>
            <p>Imputed interest, notional director pay, notional rent. They enter
               only the economico-tecnico cost level, never co.ge.</p>
        </field>
    </record>

    <menuitem id="menu_cmc_figurative" name="Figurative Costs"
              parent="menu_cmc_sec_full" action="action_cmc_figurative" sequence="20"/>
</odoo>
